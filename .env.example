# Copy to .env and fill in values.
# cp .env.example .env

# Coach / systems-under-test — local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Evaluation LLM-as-judge (rubric / pairwise preference)
EVAL_LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Retrieval / corpus
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./.chroma
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.05

# LangSmith (optional; off by default). When enabled, each coach run is one nested trace.
# Create an API key at https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=teamwork-leadership-coach
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
